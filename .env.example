# ==============================================================================
# Maine Roofing Scapes & Repairs - Environment Variables Configuration
# EverGreen MKT Performance Infrastructure
# ==============================================================================

# Nova Echo AI / CRM Webhook Integration
# Inbound quotes submitted via the website form are posted as JSON to this endpoint
NOVA_ECHO_WEBHOOK_URL="https://api.novaecho.ai/v1/webhooks/incoming/YOUR_WEBHOOK_KEY"

# Fallback generic CRM webhook (Zapier, Make, HighLevel, etc.)
CRM_WEBHOOK_URL=""

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Microsoft Clarity Project ID for session replays and scroll heatmaps
NEXT_PUBLIC_CLARITY_ID=""

# Official Maine Roofing Canonical Phone Number
# All calls are answered 24/7 and tracked via Nova Echo AI
NEXT_PUBLIC_PHONE_NUMBER="+1 (207) 383-1646"

# Base Site URL
NEXT_PUBLIC_SITE_URL="https://maineroofingscapesrepairs.com"
